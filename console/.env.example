# Copy to .env.local for local development.
#
# Both values are read at build time and inlined into the bundle. There is no runtime switch
# and no secret here — a static site has nowhere to keep one.

# demo | live
#
# demo (the default) runs entirely on the fixtures in src/api/fixtures.ts and makes no network
# request at all. live points the console at a running ops-copilot.
NEXT_PUBLIC_DATA_SOURCE=demo

# Required when NEXT_PUBLIC_DATA_SOURCE=live. The origin of the API, without a trailing slash.
#
# The API must also allow this console's origin, or the browser blocks every call before it is
# sent. On the backend, set CORS_ALLOWED_ORIGINS=http://localhost:3000 to match the dev server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Path prefix the site is served under. Empty locally; /ops-copilot on GitHub Pages, where the
# project site lives in a subdirectory. CI sets this itself.
# NEXT_PUBLIC_BASE_PATH=/ops-copilot
