# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# Anthropic Claude API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-changeme

# Browser origins allowed to call /api/**, comma-separated. Empty means no cross-origin browser
# client can reach the API at all — which is the right default for endpoints that issue refunds.
# The operator console in console/ needs its own origin listed here to work against a live API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres credentials used by both the app container and the db container
POSTGRES_DB=ops_copilot
POSTGRES_USER=ops_copilot
POSTGRES_PASSWORD=changeme
